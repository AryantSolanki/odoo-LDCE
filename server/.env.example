# Database Connection (Defaults to SQLite for instant execution, or PostgreSQL URL)
DATABASE_URL=sqlite:///./globetrotter.db
# For PostgreSQL: postgresql://user:password@localhost:5432/globetrotter

# JWT Security Configuration
SECRET_KEY=globetrotter_secret_key_change_in_production_hackathon_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS Allowed Origins (Comma-separated or * for hackathon frontend development)
CORS_ORIGINS=*
